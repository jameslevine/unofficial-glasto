{
  "expo": {
    "name": "Unofficial Glasto",
    "slug": "unofficial-glasto",
    "scheme": "glasto",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "newArchEnabled": false,
    "owner": "james.levine",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.unofficialglasto.app"
    },
    "android": {
      "package": "com.unofficialglasto.app",
      "adaptiveIcon": {
        "backgroundColor": "#0a0a0a"
      }
    },
    "web": {
      "bundler": "metro",
      "output": "static"
    },
    "plugins": [
      "expo-router",
      [
        "@rnmapbox/maps",
        {
          "RNMapboxMapsImpl": "mapbox"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "apiBaseUrl": "https://0pmdeq1cnb.execute-api.us-east-1.amazonaws.com/Prod",
      "mapboxToken": "pk.eyJ1IjoiamFtZXNsZXZpbmUiLCJhIjoiY21wZ3hkaDVzMHMwMDJyczJocTc4cWY4dyJ9.NXJgwMNHgc1ScJUxIIL04w",
      "eas": {
        "projectId": "5d3c1529-831b-4aea-8193-6693673a7e0e"
      }
    }
  }
}
